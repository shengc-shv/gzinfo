# dependencies
/node_modules

# OS
.DS_Store

# env files
.env*
!.env.example

# trending pipeline output (each fork generates its own)
/daily_reports/
/logs/

# runtime data (M2: unified history / AI assets ledger / AI telemetry)
# article-history*.json & gd-issuers.json stay committed; these are regenerated per run
/data/fetched-articles.json
/data/history/
/data/ai-assets/
/data/metrics/

# M4 TagStore 运行期产物（本地工作文件，不随代码提交；真缓存由 pre-analyze workflow 强制提交）
/data/tag-queue.json
/data/tag-incoming.json
/data/tag-store.json

# Claude Code local state (skills + commands ARE committed; cache/state aren't)
/.claude/state/
/.claude/cache/

# typescript
*.tsbuildinfo

# screenshot originals (only the cropped versions are committed)
/docs/screenshots/originals/

# pre-analysis runtime artifact (analyze-gz.ts output, regenerated per run)
/data/gz-analysis.json
ai-workspace/

# WorkBuddy 本地协作记忆（不入公开仓库）
.workbuddy/
